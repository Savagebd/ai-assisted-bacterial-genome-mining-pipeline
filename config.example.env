# Copy this file to config.env before running the pipeline.
# Then edit the values for your analysis project and genome.

# 1. Set PROJECT_DIR to your analysis project folder.
PROJECT_DIR="$HOME/Bioinformatics/09_Projects/Your_Project_Name"

# Short sample name used in output file names.
# Use only letters, numbers, underscores, and hyphens.
SAMPLE_ID="example_sample"

# 2. Create only the input folder manually, then put your assembled
#    bacterial genome FASTA file inside:
#    $PROJECT_DIR/01_Genome_FASTA/
#    The pipeline creates the downstream output folders automatically.
#
# 3. Set GENOME_FASTA to the full path or PROJECT_DIR-based path for that FASTA.
# Accepted extensions: .fna, .fa, .fasta
GENOME_FASTA="${PROJECT_DIR}/01_Genome_FASTA/example_genome.fna"

# Number of CPU threads to use.
THREADS="4"

# Path to your local Bakta database folder.
BAKTA_DB="$HOME/Bioinformatics/06_Tools/bakta_db/db-light"
